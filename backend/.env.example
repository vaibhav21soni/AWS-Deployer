# Backend Environment Variables

# AWS Configuration (Optional - can be provided via UI)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Server Configuration
PORT=8000
HOST=0.0.0.0

# CORS Configuration
CORS_ORIGINS=http://localhost:5174,http://localhost:3000

# Logging
LOG_LEVEL=INFO
