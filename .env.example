# Root Environment Variables for Docker Compose

# AWS Configuration (Optional - can be provided via UI)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Port Configuration
BACKEND_PORT=8001
FRONTEND_PORT=5174

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_INTERNAL_PORT=8000
LOG_LEVEL=INFO

# Frontend Configuration
VITE_API_URL=/api

# Domain Configuration (for production deployment)
# Leave empty for localhost development
DOMAIN=
# Example: DOMAIN=deployer.yourdomain.com
# When using a domain, update CORS_ORIGINS to include your domain
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
# Example with domain: CORS_ORIGINS=https://deployer.yourdomain.com,http://localhost:5174
